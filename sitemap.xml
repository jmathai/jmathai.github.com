---
layout: nil
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>{{ site.url }}/</loc>
    </url>

    {% for page in site.pages %}{% unless page.url contains '404' or page.sitemap == false %}
    <url>
        <loc>{{ site.url }}{{ page.url }}</loc>
    </url>
    {% endunless %}{% endfor %}

    {% for post in site.posts %}
    <url>
        <loc>{{ site.url }}{{ post.url }}</loc>
        <lastmod>{{ post.modified | default: post.date | date_to_xmlschema }}</lastmod>
    </url>
    {% endfor %}
</urlset>
